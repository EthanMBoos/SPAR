# Generated scenes are local experiments. Force-add the rare world that is
# deliberately promoted to a shared fixture; blank.xml remains a minimal test.
/sim/worlds/*.xml
!/sim/worlds/blank.xml
!/sim/worlds/utility_depot_40_v2.xml
/sim/worlds/assets/*
!/sim/worlds/assets/utility_depot_40_v2/
!/sim/worlds/assets/utility_depot_40_v2/**
/ros/src/spar/config/worlds/*.yaml
!/ros/src/spar/config/worlds/blank.yaml
!/ros/src/spar/config/worlds/utility_depot_40_v2.yaml

# BlenderMCP experiments are large local artifacts. The prompt and validator
# stay tracked; promote a rare reusable scene deliberately if it earns that.
/artifacts/worldgen/
