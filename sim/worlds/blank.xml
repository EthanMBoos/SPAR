<!-- The blank world. This file IS the world: the sim loads it, `make map`
     rasterizes it, the host viewer renders it. Obstacle sizes and poses are
     parity constants transcribed from the retired Unity scene, not layout
     suggestions: the committed AMCL map was rasterized from them
     byte for byte.

     Worlds imported from the scenario repo drop into this directory and get
     the same treatment: `make map WORLD=<name>` plus a matching
     autonomy_<name>.yaml. -->
<mujoco model="blank">
  <compiler angle="radian"/>

  <!-- The timestep is authoritative here (500 Hz). Training and deployment
       read the same file, so physics parity is by construction, not by two
       defaults agreeing. -->
  <option timestep="0.002" integrator="implicitfast" magnetic="0 0 0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="5 5"
              reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="sun" directional="true" pos="0 0 15" dir="0 0 -1"/>
    <!-- The viewer's home view: framing the whole site from the south. -->
    <camera name="overview" pos="0 -14 10" xyaxes="1 0 0 0 0.6 0.8"/>

    <!-- Finite size on purpose: the rasterizer's bounds logic counts the
         floor toward map extents (a sparse world is still as big as its
         floor). -->
    <geom name="floor" type="plane" size="20 20 1" material="grid"/>

    <!-- Obstacles. Everything solid must cross the lidar plane (z 0.567)
         or lint_world.py flags it as a stealth obstacle. -->
    <geom name="rack_a" type="box" size="0.8 0.3 0.6" pos="4 1.5 0.6"
          rgba="0.5 0.52 0.55 1"/>
    <geom name="rack_b" type="box" size="0.8 0.3 0.6" pos="-4 -1.2 0.6"
          rgba="0.5 0.52 0.55 1"/>
    <geom name="rack_c" type="box" size="0.8 0.3 0.6" pos="0 -3.9 0.6"
          rgba="0.5 0.52 0.55 1"/>
    <!-- The anomaly. Pure red on purpose: the HSV detector's red bands
         (hue 0-4 / 176-180, sat >= 150, anomaly_detector.cpp) must catch
         MuJoCo's shading of this rgba. Adjust the rgba if lighting changes,
         never the detector's bands. -->
    <geom name="anomaly_drum" type="cylinder" size="0.3 0.45" pos="5.6 0.3 0.45"
          rgba="1 0 0 1"/>

    <!-- Visual-only pads (contype 0 conaffinity 0): they can't become
         stealth obstacles and the map never changes when they move. -->
    <geom name="checkpoint_0" type="box" size="0.35 0.35 0.004" pos="7 2.5 0.004"
          contype="0" conaffinity="0" group="1" rgba="0.2 0.8 0.3 1"/>
    <geom name="checkpoint_1" type="box" size="0.35 0.35 0.004" pos="7 -2.5 0.004"
          contype="0" conaffinity="0" group="1" rgba="0.2 0.8 0.3 1"/>
    <geom name="checkpoint_2" type="box" size="0.35 0.35 0.004" pos="-7 -2.5 0.004"
          contype="0" conaffinity="0" group="1" rgba="0.2 0.8 0.3 1"/>
    <geom name="checkpoint_3" type="box" size="0.35 0.35 0.004" pos="-7 2.5 0.004"
          contype="0" conaffinity="0" group="1" rgba="0.2 0.8 0.3 1"/>
    <geom name="dock_pad" type="box" size="0.9 0.9 0.005" pos="0 0 0.005"
          contype="0" conaffinity="0" group="1" rgba="0.2 0.4 0.8 1"/>
    <geom name="landing_pad" type="cylinder" size="0.5 0.005" pos="-2 -1 0.005"
          contype="0" conaffinity="0" group="1" rgba="0.25 0.3 0.4 1"/>
  </worldbody>

  <include file="../robots/husky.xml"/>
  <include file="../robots/x2.xml"/>
</mujoco>
